# Shadow Visitor breathing, seamless loop (inhale, exhale). Play near it.
@output ../sfx/enemy_breath_loop.wav
@length 3.0
@seed 18
@loop
layer brown amp=0.8 attack=1.0 dur=1.3 fade=0.4 lp=700 hp=90
layer brown at=1.5 amp=1.0 attack=0.2 dur=1.2 fade=0.8 lp=500 hp=70
layer sine at=1.5 freq=85 amp=0.06 attack=0.2 dur=1.2 fade=0.8
