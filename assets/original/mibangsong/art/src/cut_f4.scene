@sprite mbs_tiles_shore.pix sluice_1_0 80 112
@sprite mbs_tiles_shore.pix sluice_2_0 96 112
@sprite mbs_tiles_shore.pix sluice_3_0 112 112
@sprite mbs_tiles_shore.pix sluice_0_1 64 128
@sprite mbs_tiles_shore.pix sluice_1_1 80 128
@sprite mbs_tiles_shore.pix sluice_2_1 96 128
@sprite mbs_tiles_shore.pix sluice_3_1 112 128
@sprite mbs_tiles_shore.pix sluice_0_2 64 144
