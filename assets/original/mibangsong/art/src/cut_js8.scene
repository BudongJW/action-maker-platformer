# PRIVATE (미방송분). Cut JS8 (real scare, largest): at the HI-FI boundary it covers up to 20% of the screen, then a hard cut to HI-FI silence
@palette ../../../art/palette/night-school.pal
@size 320 180
@output ../cuts/js8.png
@preview ../previews/js8_x2.png 2
@swap ../palette/linear.pal
@fill D

@tiles w mbs_tiles_workroom.pix
@tiles s mbs_tiles_shore.pix
@tiles x mbs_tiles_extra.pix
@tiles g ../../../art/src/tiles_gut.pix
@legend S s:shore_top
@legend s s:shore_fill
@sprite mbs_bg_reservoir.pix layer 0 0
@layer
....................
....................
....................
....................
....................
....................
....................
....................
....................
....................
SSSSSSSSSSSSSSSSSSSS
ssssssssssssssssssss
@sprite mbs_tiles_extra.pix setlight_0_0 40 112
@sprite mbs_tiles_extra.pix setlight_0_1 40 128
@sprite mbs_tiles_extra.pix setlight_0_2 40 144
@sprite mbs_tiles_extra.pix setlight_0_0 264 112
@sprite mbs_tiles_extra.pix setlight_0_1 264 128
@sprite mbs_tiles_extra.pix setlight_0_2 264 144
@sprite mbs_tiles_extra.pix prop_dummy_0_0 136 128
@sprite mbs_tiles_extra.pix prop_dummy_0_1 136 144
@sprite mbs_gyeongho.pix run_1 220 121
@darkness K 0.55
@light 48 118 60
@light 272 118 60
@sprite mbs_overdub_big.pix cover 40 40 over
@sprite mbs_fx_viewfinder.pix rec 0 0 over
@sprite mbs_ui_badges.pix linear 14 24 over
