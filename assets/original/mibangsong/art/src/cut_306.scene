# PRIVATE (미방송분). Cut 3-06: the deepest part of old Neoulli, toward the middle of the reservoir: the jacket hangs on a stone wall, far from the pier
@palette ../../../art/palette/night-school.pal
@size 320 180
@output ../cuts/306.png
@preview ../previews/306_x2.png 2
@swap ../palette/hifi.pal
@fill D

@tiles w mbs_tiles_workroom.pix
@tiles s mbs_tiles_shore.pix
@tiles x mbs_tiles_extra.pix
@tiles g ../../../art/src/tiles_gut.pix
@tiles h mbs_tiles_house.pix
@legend A s:water_0
@legend T s:stonewall
@legend a s:water_fill
@legend m s:mud
@sprite mbs_bg_reservoir.pix layer 0 0
@layer
