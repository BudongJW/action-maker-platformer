# PRIVATE (미방송분). Evidence and insert items, 32x32, for the deduction board and INSERT cuts.
@palette ../../../art/palette/night-school.pal
@size 32 32
@output ../ui/mbs_items.png
@preview ../previews/mbs_items_x3.png 3
@columns 6

