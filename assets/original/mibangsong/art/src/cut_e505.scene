# PRIVATE (미방송분). Cut E5-05: the 2026 memorial day: wind over the water; Seojin among the people; no ghost appears
@palette ../../../art/palette/night-school.pal
@size 320 180
@output ../cuts/e505.png
@preview ../previews/e505_x2.png 2
@swap ../palette/2026.pal
@fill D

@tiles w mbs_tiles_workroom.pix
@tiles s mbs_tiles_shore.pix
@tiles x mbs_tiles_extra.pix
