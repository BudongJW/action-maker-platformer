# PRIVATE (미방송분). Cut E1-03: the memorial day for the drowned village; in the crowd the old name goes round again, one word heard
@palette ../../../art/palette/night-school.pal
@size 320 180
@output ../cuts/e103.png
@preview ../previews/e103_x2.png 2
@swap ../palette/2026.pal
@fill D

@tiles w mbs_tiles_workroom.pix
@tiles s mbs_tiles_shore.pix
@tiles x mbs_tiles_extra.pix
