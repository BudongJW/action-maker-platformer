# PRIVATE (미방송분). the untied seven-knot cotton laid toward the water (4-12, 5-02).
@palette ../../../art/palette/night-school.pal
@size 176 40
@output ../tiles/mbs_prop_cloth.png
@preview ../previews/mbs_prop_cloth_x2.png 2
@columns 1

# the untied cotton: falls from the hand to the ground, then lies long toward the water
@frame cloth_drape
