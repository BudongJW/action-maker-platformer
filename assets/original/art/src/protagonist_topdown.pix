@frame left_0 mirror=_side_step_a
@frame left_1 mirror=_side_stand
@frame left_2 mirror=_side_step_b
@frame right_0 copy=protagonist_side.pix:walk_0
@frame right_1 copy=protagonist_side.pix:idle_0
@frame right_2 copy=protagonist_side.pix:walk_2

@frame _up_stand copy=protagonist_side.pix:turn_back

@frame up_0 base=_up_stand
