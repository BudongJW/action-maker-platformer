# Shadow Visitor, top-down sheet in the RPG Maker MV/MZ single-character
# layout ("$" prefix): 3 columns (step, stand, step) x 4 rows (down, left,
# right, up). Left/right reuse the side-view frames.
@palette ../palette/night-school.pal
@size 32 56
@output ../characters/$enemy_shadow_visitor_topdown.png
@preview ../previews/enemy_shadow_visitor_topdown_x4.png 4
@columns 3

@frame _side_a copy=enemy_shadow_visitor.pix:walk_0
@frame _side_s copy=enemy_shadow_visitor.pix:idle_0
@frame _side_b copy=enemy_shadow_visitor.pix:walk_1

@frame down_0
