# Mock-up: title screen. Background = the parallax layers, a placeholder
# box where the logo goes (no title yet) and a four-item menu.
@palette ../palette/night-school.pal
@size 320 180
@output ../mockups/title_mock.png
@preview ../previews/title_mock_x3.png 3
@fill D
@tiles e tiles_exterior.pix
@legend G e:ground_top
@legend g e:ground_fill
@legend f e:fence_0_0
@legend h e:fence_0_1
@tiles ui ui_panel.pix
@tiles pp ui_paper.pix
@tiles us ui_small.pix
@legend { ui:tl
@legend ^ ui:t
@legend } ui:tr
@legend [ ui:l
@legend = ui:c
@legend ] ui:r
@legend < ui:bl
@legend _ ui:b
@legend > ui:br
@legend ( pp:tl
@legend - pp:t
@legend ) pp:tr
@legend | pp:l
@legend : pp:c
@legend ! pp:r
@legend , pp:bl
@legend ` pp:b
@legend ; pp:br
@legend * us:_textbar
@legend + us:_inkbar
@legend & us:cursor
@sprite bg_sky.pix sky 0 0
@sprite bg_far.pix far 0 0
@sprite bg_mid.pix school 0 0
@layer
