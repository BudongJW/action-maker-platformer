# Concept: at the end of the pier, the water ghost rises beside the
# planks and reaches up, while pale hands push through the gaps in the deck.
@palette ../palette/night-school.pal
@size 320 180
@output ../concepts/concept_pier_grab.png
@preview ../previews/concept_pier_grab_x3.png 3
@fill D
@tiles ps tiles_port_side.pix
@legend D ps:pier_deck
@legend P ps:piling
@legend X ps:brace
@legend S ps:sea_surface_0
@legend s ps:sea_fill
@legend W ps:house_wall
@legend w ps:house_wall_base
@legend L ps:window_lit
@legend r ps:roof_tin_0_0
@legend R ps:roof_tin_1_0
@legend q ps:roof_tin_2_0
@legend c ps:crate
@legend t ps:tire_fender
@legend b ps:buoy_hanging
@sprite bg_sea.pix layer 0 0
@sprite bg_harbor.pix layer 0 0
@layer
....................
....................
....................
rRq.................
WLW.................
WWW.................
wwwc................
DDDDDDDDDDD.........
..P.X.P.X.P.........
@sprite protagonist_side.pix hurt 144 80
@sprite creature_water_ghost.pix reach 174 112 flip
@sprite creature_floor_hands.pix emerge_1 108 92
# the sea in front: boats and anything in the water sink below the surface
@layer
....................
....................
....................
....................
....................
....................
....................
....................
....................
SSSSSSSSSSSSSSSSSSSS
ssssssssssssssssssss
ssssssssssssssssssss
@darkness K 0.8
@light 156 104 34
@light 186 128 26
@sprite fx_vignette.pix vignette 0 0 over
