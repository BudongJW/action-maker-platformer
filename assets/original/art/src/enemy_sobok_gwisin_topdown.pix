# Sobok ghost, top-down sheet in the MV/MZ "$" layout (3 x 4). She floats:
# the "step" frames bob one pixel up instead of moving legs. Down reuses the
# front-view float frames.
@palette ../palette/night-school.pal
@size 24 40
@output ../characters/$enemy_sobok_gwisin_topdown.png
@preview ../previews/enemy_sobok_gwisin_topdown_x4.png 4
@columns 3

@frame _front copy=enemy_sobok_gwisin.pix:float_0
