# Top-down mock-up: a whole floor of the school. Two classrooms to the
# north, the corridor with doors, lockers and stairs, the shoe-locker
# entrance and the restroom to the south. Zombie students are already in.
@palette ../palette/night-school.pal
@size 512 384
@output ../mockups/map_school_floor_td.png
@preview ../previews/map_school_floor_td_x2.png 2
@fill D

@tiles td tiles_topdown.pix
@tiles tw tiles_topdown_walltop.pix
@tiles ns tiles_night_school.pix
@tiles cl tiles_classroom.pix
@tiles rr tiles_restroom.pix
@tiles pr tiles_props.pix
@tiles tn tiles_town_td.pix
@tiles of tiles_office_td.pix
@legend A tw:walltop_15
@legend B td:face_upper
@legend C td:face_lower
@legend D tw:walltop_13
@legend E td:floor_wood_shadow
@legend F tw:walltop_05
