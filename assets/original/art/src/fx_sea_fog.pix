# Sea fog overlay, 320x180: a dithered band of mist over the water line,
# translucent white. Draw it above the darkness in scenes.
@palette ../palette/light.pal
@size 320 180
@output ../fx/fx_sea_fog.png
@preview ../previews/fx_sea_fog_x2.png 2
@frame fog
