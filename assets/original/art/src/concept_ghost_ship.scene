# Concept: a ghost ship drifts out of the sea fog, its lamps burning
# spirit green. The protagonist stands at the end of the pier.
@palette ../palette/night-school.pal
@size 320 180
@output ../concepts/concept_ghost_ship.png
@preview ../previews/concept_ghost_ship_x3.png 3
@fill D
@tiles ps tiles_port_side.pix
@legend D ps:pier_deck
@legend P ps:piling
@legend X ps:brace
@legend S ps:sea_surface_0
@legend s ps:sea_fill
@legend W ps:house_wall
@legend w ps:house_wall_base
@legend L ps:window_lit
@legend r ps:roof_tin_0_0
@legend R ps:roof_tin_1_0
@legend q ps:roof_tin_2_0
@legend c ps:crate
@legend t ps:tire_fender
@legend b ps:buoy_hanging
@sprite bg_sea.pix layer 0 0
@sprite bg_harbor.pix layer 0 0
@layer
....................
....................
....................
rRq.................
WLW.................
WWW.................
wwwc................
DDDDDDDDDDD.........
..P.X.P.X.P.........
@sprite boat_squid.pix ghost 196 102
@sprite protagonist_side.pix idle_0 136 80
# the sea in front: boats and anything in the water sink below the surface
@layer
....................
....................
....................
....................
....................
....................
....................
....................
....................
SSSSSSSSSSSSSSSSSSSS
ssssssssssssssssssss
ssssssssssssssssssss
@darkness K 0.74
@light 252 122 58
@light 148 100 16
@sprite fx_sea_fog.pix fog 0 0 over
@sprite enemy_dokkaebi_bul.pix flicker_1 214 74 over
@sprite enemy_dokkaebi_bul.pix flicker_3 286 86 over
@sprite fx_vignette.pix vignette 0 0 over
