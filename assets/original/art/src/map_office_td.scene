@sprite protagonist_topdown.pix down_1 188 128
@sprite zombie_office_topdown.pix right_1 92 128
@sprite zombie_office_topdown.pix left_1 284 80
@sprite zombie_office_topdown.pix down_1 316 192
@sprite zombie_guard_topdown.pix up_1 44 64
