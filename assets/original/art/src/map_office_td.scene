# Top-down mock-up: a company floor during a blackout. Elevator lobby on
# the left, open-plan cubicles with a few monitors still on, a glass
# meeting room and a pantry on the right. Office zombies wander between
# the desks; the protagonist hides in a cubicle.
@palette ../palette/night-school.pal
@size 480 256
@output ../mockups/map_office_td.png
@preview ../previews/map_office_td_x2.png 2
@fill D

@tiles td tiles_topdown.pix
@tiles tw tiles_topdown_walltop.pix
@tiles ns tiles_night_school.pix
@tiles cl tiles_classroom.pix
@tiles rr tiles_restroom.pix
@tiles pr tiles_props.pix
@tiles tn tiles_town_td.pix
@tiles of tiles_office_td.pix
@legend A tw:walltop_15
@legend B of:face_upper
@legend C of:face_lower
@legend D of:floor_office
@legend E of:floor_carpet
@legend F tw:walltop_14
@legend G of:elevator_0_0
@legend H of:elevator_1_0
@legend I of:elevator_0_1
@legend J of:elevator_1_1
@legend K of:exit_sign
@legend L of:window_blinds_0_0
@legend M of:window_blinds_1_0
@legend N of:window_blinds_0_1
@legend O of:window_blinds_1_1
@legend P of:whiteboard_0_0
@legend Q of:whiteboard_1_0
@legend R of:plant
@legend S of:desk_pc_on
@legend T of:desk_pc_off
@legend U of:partition_v
@legend V td:teacher_desk_0_0
@legend W td:teacher_desk_1_0
@legend X of:office_chair
@legend Y of:partition_h
@legend Z of:sofa_0_0
@legend a of:sofa_1_0
@legend b of:water_cooler
@legend c of:printer
@legend d of:file_cabinet
@legend e tn:vending_0_0
@legend f tn:vending_0_1

