# Port tiles for side-scrolling scenes, 16x16: pier deck (one-way),
# pilings and braces, animated sea surface (hazard), props, port houses.
@palette ../palette/night-school.pal
@size 16 16
@output ../tiles/tiles_port_side.png
@preview ../previews/tiles_port_side_x4.png 4
@columns 8

