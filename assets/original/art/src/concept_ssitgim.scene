# Concept: ssitgim-gut, the road-clearing. The protagonist and the mudang
# hold the long white cloth taut; the paper soul boat slides along it with a
# soul glowing inside, and the sobok ghost follows it, calm for once.
@palette ../palette/night-school.pal
@size 320 180
@output ../concepts/concept_ssitgim.png
@preview ../previews/concept_ssitgim_x3.png 3
@fill D
@tiles g tiles_gut.pix
@tiles t tiles_night_school.pix
@legend B g:beam
@legend H g:hanji_wall
@legend h g:hanji_wall_warm
@legend | g:post
@legend m g:mat
@legend F t:floor_top
@legend f t:floor_fill
