# Concept: getting out at dawn. The same schoolyard in the dawn palette:
# the sky turns rose, the school is only a silhouette, the gate is open.
@palette ../palette/night-school.pal
@size 320 180
@output ../concepts/concept_dawn_escape.png
@preview ../previews/concept_dawn_escape_x3.png 3
@swap ../palette/dawn.pal
@fill D

@tiles e tiles_exterior.pix
@legend G e:ground_top
@legend g e:ground_fill
@legend a e:fence_0_0
@legend b e:fence_0_1
@legend l e:streetlamp_0_0
@legend m e:streetlamp_0_1
@legend n e:streetlamp_0_2
@legend s e:swing_0_0
@legend t e:swing_1_0
@legend u e:swing_0_1
@legend v e:swing_1_1

@sprite bg_sky.pix sky 0 0
@sprite bg_far.pix far 0 0
@sprite bg_mid.pix school 0 0

@layer
....................
....................
....................
....................
....................
....................
.............l......
aaaaaaaaaaaaama.aaaa
bbbbbbbsbbbbbnbbbbbb
GGGGGGGGGGGGGGGGGGGG
gggggggggggggggggggg
gggggggggggggggggggg

@layer
....................
....................
....................
....................
....................
....................
....................
.......st...........
.......uv...........
....................
....................
....................

@sprite protagonist_side.pix run_0 150 112 keep
@darkness K 0.15
@light 254 34 60
