...l.l.l.....l.l.l..
...k.k.k.....k.k.k..
...l.l.l.....l.l.l..
....................

@sprite protagonist_topdown.pix down_1 268 48
@sprite enemy_sobok_gwisin_topdown.pix down_1 156 120
@darkness K 0.8
@cone 280 76 120 40 150
@light 40 72 26
@light 88 56 30
@light 168 156 18
