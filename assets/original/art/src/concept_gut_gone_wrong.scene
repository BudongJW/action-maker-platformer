# Concept: the rite goes wrong. The candles are out, the musicians have fled
# and left the drum, the painting's eyes have turned red, the mudang turns
# with spirit eyes and knives, and the Shadow Visitor rises behind the altar.
@palette ../palette/night-school.pal
@size 320 180
@output ../concepts/concept_gut_gone_wrong.png
@preview ../previews/concept_gut_gone_wrong_x3.png 3
@fill D
@tiles g tiles_gut.pix
@tiles t tiles_night_school.pix
@legend B g:beam
@legend H g:hanji_wall
@legend h g:hanji_wall_warm
@legend | g:post
@legend m g:mat
@legend F t:floor_top
@legend f t:floor_fill
