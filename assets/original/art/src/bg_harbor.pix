# Parallax layer over bg_sea: the far shore with village lights, a
# lighthouse sweeping its beam, masts of moored boats. Transparent above.
@palette ../palette/night-school.pal
@size 320 180
@output ../backgrounds/bg_harbor.png
@preview ../previews/bg_harbor_x2.png 2
@frame layer
