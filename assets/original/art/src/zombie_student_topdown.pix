@frame _a copy=zombie_student.pix:walk_0
@frame _s copy=zombie_student.pix:idle_0
@frame _b copy=zombie_student.pix:walk_2
@frame left_0 mirror=_a
@frame left_1 mirror=_s
@frame left_2 mirror=_b
@frame right_0 shift=_a,0,0
@frame right_1 shift=_s,0,0
@frame right_2 shift=_b,0,0

