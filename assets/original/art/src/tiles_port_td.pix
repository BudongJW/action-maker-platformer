# Sea and port town tiles, top-down (3/4 view), 16x16. The quay is a wall
# face that drops into the water; boats, buoys and pier ends are drawn over
# the water tiles. Water tiles have two frames for a slow wave loop.
@palette ../palette/night-school.pal
@size 16 16
@output ../tiles/tiles_port_td.png
@preview ../previews/tiles_port_td_x4.png 4
@columns 8

