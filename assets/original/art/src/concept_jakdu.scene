# Concept: jakdu-tagi. Barefoot on the edges of two upright blades, the
# mudang balances with a flag and a fan while the drum beats and the village
# watches. If the spirit has truly come down, the blades do not cut.
@palette ../palette/night-school.pal
@size 320 180
@output ../concepts/concept_jakdu.png
@preview ../previews/concept_jakdu_x3.png 3
@fill D
@tiles g tiles_gut.pix
@tiles t tiles_night_school.pix
@legend B g:beam
@legend H g:hanji_wall
@legend h g:hanji_wall_warm
@legend | g:post
@legend m g:mat
@legend F t:floor_top
@legend f t:floor_fill
