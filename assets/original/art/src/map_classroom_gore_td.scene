@legend b td:door_open_0_0
@legend c td:door_open_0_1
@legend d cl:clock
@legend e cl:cabinet_0_0
@legend f cl:cabinet_1_0
@legend g cl:cabinet_0_1
@legend h cl:cabinet_1_1
@legend i td:teacher_desk_0_0
@legend j td:teacher_desk_1_0
@legend k td:desk
@legend l td:chair

