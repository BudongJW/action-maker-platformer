..........b.........
@sprite tiles_gut.pix candle_0 76 96
@sprite tiles_gut.pix candle_1 164 96
@sprite tiles_gut.pix neokdang_soul 116 96
@sprite protagonist_side.pix idle_0 92 80
@sprite npc_mudang_white.pix pole 136 73
@sprite creature_water_ghost.pix rise_1 196 110
