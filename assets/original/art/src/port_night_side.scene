# Mock-up: the end of a pier at night, side view. A port house with a lit
# window, the pier deck on pilings, a squid boat moored with its lamps lit,
# the open sea and a lighthouse on the far point.
@palette ../palette/night-school.pal
@size 320 180
@output ../mockups/port_night_side.png
@preview ../previews/port_night_side_x3.png 3
@fill D
@tiles ps tiles_port_side.pix
@legend D ps:pier_deck
@legend P ps:piling
@legend X ps:brace
@legend S ps:sea_surface_0
@legend s ps:sea_fill
@legend W ps:house_wall
@legend w ps:house_wall_base
@legend L ps:window_lit
@legend r ps:roof_tin_0_0
@legend R ps:roof_tin_1_0
@legend q ps:roof_tin_2_0
@legend c ps:crate
@legend t ps:tire_fender
@legend b ps:buoy_hanging
@sprite bg_sea.pix layer 0 0
@sprite bg_harbor.pix layer 0 0
@layer
....................
....................
....................
rRq.................
WLW.................
WWW.................
wwwc................
DDDDDDDDDDD.........
..P.X.P.X.P.........
@layer
....................
....................
....................
....................
....................
....................
....................
..........t.........
..........b.........
@sprite boat_squid.pix bob_0 196 102
@sprite protagonist_side.pix idle_0 120 80
# the sea in front: boats and anything in the water sink below the surface
@layer
....................
