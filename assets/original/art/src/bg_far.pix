# Parallax layer 2: distant hills and apartment blocks with a few lit
# windows. Transparent above the skyline, wraps horizontally. Scroll ~0.2.
@palette ../palette/night-school.pal
@size 320 180
@output ../backgrounds/bg_far.png
@preview ../previews/bg_far_x2.png 2

@frame far
