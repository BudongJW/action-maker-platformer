# Top-down mock-up: a community service centre (주민센터) after hours. The
# queue display still shows 444; zombies sit in the waiting chairs facing
# the counter, and a clerk zombie still stands behind it.
@palette ../palette/night-school.pal
@size 416 288
@output ../mockups/map_civic_td.png
@preview ../previews/map_civic_td_x2.png 2
@fill D

@tiles td tiles_topdown.pix
@tiles tw tiles_topdown_walltop.pix
@tiles ns tiles_night_school.pix
@tiles cl tiles_classroom.pix
@tiles rr tiles_restroom.pix
@tiles pr tiles_props.pix
@tiles tn tiles_town_td.pix
@tiles of tiles_office_td.pix
@legend A tw:walltop_15
@legend B of:face_upper
@legend C of:face_lower
@legend D of:floor_carpet
@legend E of:floor_marble
@legend F tw:walltop_10
@legend G tw:walltop_08
@legend H tw:walltop_02
@legend I tn:sidewalk
@legend J tn:curb_s
@legend K of:bookshelf_0_0
@legend L of:bookshelf_0_1
@legend M of:window_blinds_0_0
@legend N of:window_blinds_1_0
@legend O of:window_blinds_0_1
@legend P of:window_blinds_1_1
@legend Q of:number_display_0_0
@legend R of:number_display_1_0
@legend S cl:clock
@legend T of:exit_sign
@legend U cl:bulletin_0_0
@legend V cl:bulletin_1_0
@legend W of:printer
@legend X of:desk_pc_on
@legend Y of:desk_pc_off
@legend Z of:file_cabinet
@legend a of:office_chair
@legend b of:counter_l
@legend c of:counter_m
@legend d of:counter_r
@legend e of:ticket_machine
@legend f of:bench_0_0
@legend g of:bench_1_0
@legend h of:water_cooler
@legend i of:plant

