@sprite protagonist_topdown.pix up_1 188 224
@sprite zombie_guard_topdown.pix down_1 92 80
@sprite zombie_office_topdown.pix down_1 236 80
@sprite zombie_elder_topdown.pix up_1 76 144
@sprite zombie_student_topdown.pix up_1 140 176
@sprite zombie_office_topdown.pix up_1 204 144
