# Banded vignette overlay, 320x180, dithered between steps. Draw it on
# top of the game view (CanvasLayer); tighten it in the other world.
@palette ../palette/dark.pal
@size 320 180
@output ../fx/fx_vignette.png
@preview ../previews/fx_vignette_x2.png 2

@frame vignette















