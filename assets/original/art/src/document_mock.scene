# Mock-up: reading a note. The corridor is dimmed with a dither step, the
# note is the paper 9-slice, dark bars stand in for handwriting.
@palette ../palette/night-school.pal
@size 320 180
@output ../mockups/document_mock.png
@preview ../previews/document_mock_x3.png 3
@fill D
@tiles ui ui_panel.pix
@tiles pp ui_paper.pix
@tiles us ui_small.pix
@legend { ui:tl
@legend ^ ui:t
@legend } ui:tr
@legend [ ui:l
@legend = ui:c
@legend ] ui:r
@legend < ui:bl
@legend _ ui:b
@legend > ui:br
@legend ( pp:tl
@legend - pp:t
@legend ) pp:tr
@legend | pp:l
@legend : pp:c
@legend ! pp:r
@legend , pp:bl
@legend ` pp:b
@legend ; pp:br
@legend * us:_textbar
@legend + us:_inkbar
@legend & us:cursor


@tiles t tiles_night_school.pix
@legend C t:ceiling
@legend P t:wall_plaster
@legend X t:wall_plaster_crack
@legend R t:wall_rail
@legend w t:wall_wainscot
@legend h t:wall_wainscot_hand
@legend F t:floor_top
@legend f t:floor_fill
@legend 1 t:window_0_0
@legend 2 t:window_1_0
@legend 3 t:window_0_1
@legend 4 t:window_1_1
@legend 5 t:door_0_0
@legend 6 t:door_1_0
@legend 7 t:door_0_1
@legend 8 t:door_1_1
@legend 9 t:door_0_2
@legend 0 t:door_1_2
@legend L t:lamp_off
@legend O t:lamp_on
@legend g t:geumjul
@legend s t:sign_plate
@legend T t:talisman
@legend d t:desk
@legend k t:locker_0_0
@legend l t:locker_0_1
@legend c t:candle_lit_0
@legend n t:note_glint

# walls and structure
@layer
CCCCCCCCCCCCCCCCCCCC
PPPPPPPPPPPPPPPPPPPP
PP12PPPPPPPP12PPPPPP
PP34PPPPPPXP34PPPPPP
PPPPPPPPPPPPPPPPPPPP
PPPPPPPPPPPPPPPPPPPP
PPPPPPPPPPPPPPPPPPPP
RRRRRRR56RRRRRRRR56R
wwwwwww78wwwwwwhw78w
wwwwwww90wwwwwwww90w
FFFFFFFFFFFFFFFFFFFF
ffffffffffffffffffff

