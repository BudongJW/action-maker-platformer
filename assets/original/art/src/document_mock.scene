@darkness K 0.78
@cone 80 152 0 34 130
@light 248 26 46
@light 48 48 22
@light 208 48 22
@light 108 92 20
@light 138 76 18
@light 40 150 20
@light 216 152 14

@sprite enemy_dokkaebi_bul.pix flicker_0 100 84 over
@sprite enemy_dokkaebi_bul.pix flicker_2 130 68 over
@tiles fx fx_transition.pix
@legend % fx:step_09
