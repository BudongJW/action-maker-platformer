# Flashlight beam for PointLight2D, 128x64, origin at the left middle
# (set the light offset so the origin sits on the flashlight lens).
@palette ../palette/light.pal
@size 128 64
@output ../lights/light_cone.png
@preview ../previews/light_cone_x2.png 2

@frame cone
