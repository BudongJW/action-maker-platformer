# Screen transition: 16x16 ordered-dither tile in 17 steps. Fill the
# screen with it and advance the frame for a pixel-art fade to black.
@palette ../palette/dark.pal
@size 16 16
@output ../fx/fx_transition.png
@preview ../previews/fx_transition_x4.png 4
@columns 17

