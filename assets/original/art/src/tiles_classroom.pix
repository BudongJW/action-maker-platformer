# Classroom set, side view, 16x16 tiles. Floor, walls and windows come
# from tiles_night_school; desks from its "desk" tile.
@palette ../palette/night-school.pal
@size 16 16
@output ../tiles/tiles_classroom.png
@preview ../previews/tiles_classroom_x4.png 4
@columns 8

